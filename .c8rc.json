{
    "all": true,
    "src": ["src"],
    "include": ["src/**/*.ts"],
    "exclude": ["test"],
    "extension": [".ts"],
    "reporter": ["lcov", "text-summary"],
    "report-dir": "./coverage",
    "check-coverage": true,
    "branches": 75,
    "lines": 50,
    "functions": 20,
    "statements": 50
}
