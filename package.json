{
    "name": "@openhps/drools",
    "version": "0.1.0-alpha.0",
    "description": "Open Hybrid Positioning System",
    "author": "Maxim Van de Wynckel",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/OpenHPS/openhps-drools.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "type": "commonjs",
    "sideEffects": false,
    "main": "./dist/cjs/index.js",
    "types": "./dist/types/index.d.ts",
    "module": "./dist/esm/index.js",
    "es2015": "./dist/esm/index.js",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "src/**/*",
        "LICENSE"
    ],
    "scripts": {
        "test": "mocha --config test/.mocharc.json",
        "test:jenkins": "jenkins-mocha --cobertura --config test/.mocharc.json",
        "cover": "c8 mocha --config test/.mocharc.json",
        "cover:ci": "c8 mocha --config test/.mocharc.ci.json && c8 report --reporter=cobertura",
        "lint": "eslint . && node scripts/check-peers.mjs",
        "clean": "shx rm -rf ./dist && shx rm -rf ./docs/out",
        "build": "npm run clean && npm-run-all --parallel build:ts:*",
        "build:ts:cjs": "tsc --build ./tsconfig/tsconfig.bundle.cjs.json",
        "build:ts:esm": "tsc --build ./tsconfig/tsconfig.bundle.esm.json && node ./scripts/finalize-esm.mjs",
        "build:ts:types": "tsc --build ./tsconfig/tsconfig.bundle.types.json",
        "publish:development": "npm run bump:beta && npm publish --tag dev",
        "publish:beta": "npm run bump:beta && npm publish --tag beta",
        "publish:release": "npm run bump:beta && npm publish --tag latest",
        "bump:development": "commit-and-tag-version --prerelease alpha -m 'chore(alpha): %s' --skip.changelog",
        "bump:beta": "commit-and-tag-version --prerelease beta -m 'chore(beta): %s' --skip.changelog",
        "bump:release": "commit-and-tag-version -m 'chore(release): %s' --skip.changelog",
        "serve": "ts-node ./src/bin/host.ts",
        "generate": "ts-node ./src/bin/generate.ts",
        "prepare": "husky",
        "build:typedoc": "typedoc --options docs/typedoc.json"
    },
    "keywords": [
        "openhps",
        "drools",
        "kie",
        "business rules"
    ],
    "dependencies": {
        "axios": "^1.19.0",
        "chalk": "^4.1.2",
        "fs-extra": "^11.1.0",
        "node-git-server": "^1.0.0",
        "tslib": "^2.8.1"
    },
    "peerDependencies": {
        "@openhps/core": ">=1.0.16 <2",
        "reflect-metadata": ">=0.2.2 <1"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.8.1",
        "@commitlint/config-conventional": "^19.8.1",
        "@eslint/js": "^9.34.0",
        "@openhps/core": "^1.0.16",
        "@openhps/geospatial": "^0.1.33",
        "@openhps/rf": "^1.0.4",
        "@types/chai": "^5.2.2",
        "@types/fs-extra": "^9.0.13",
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.3.0",
        "c8": "^12.0.0",
        "chai": "^6.2.2",
        "commit-and-tag-version": "^13.1.2",
        "eslint": "^9.34.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsdoc": "^54.1.1",
        "eslint-plugin-prettier": "^5.5.4",
        "globals": "^16.3.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.7",
        "mocha": "^12.0.0",
        "mocha-junit-reporter": "^2.2.1",
        "mocha-multi-reporters": "^1.5.1",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.9.6",
        "reflect-metadata": ">=0.1.13",
        "shx": "^0.4.0",
        "terser-webpack-plugin": "^5.3.14",
        "ts-node": "^10.9.2",
        "typedoc": "^0.28.20",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.66.0",
        "webpack": "^5.101.3",
        "webpack-cli": "^6.0.1"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "packageManager": "npm@10.9.2",
    "lsd:module": true,
    "husky": {
        "hooks": {
            "pre-commit": "npm run lint",
            "pre-push": "npm run test",
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    }
}
